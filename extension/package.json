{
  "name": "smartcopy-vscode",
  "publisher": "smartcopy",
  "displayName": "SmartCopy",
  "description": "CTRL+A for developers - copy only source code, never dependencies.",
  "version": "0.1.0",
  "icon": "media/displayicon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "smartcopy",
          "title": "SmartCopy",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "smartcopy": [
        {
          "type": "webview",
          "id": "smartcopy.dashboard",
          "name": "SmartCopy"
        }
      ]
    },
    "commands": [
      {
        "command": "smartcopy.openDashboardFor",
        "title": "SmartCopy: Open Dashboard for This Folder"
      },
      {
        "command": "smartcopy.refresh",
        "title": "SmartCopy: Refresh",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "smartcopy.openDashboardFor",
          "when": "explorerResourceIsFolder",
          "group": "7_modification"
        }
      ],
      "view/title": [
        {
          "command": "smartcopy.refresh",
          "when": "view == smartcopy.dashboard",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.9",
    "mocha": "^12.0.0",
    "typescript": "^5.4.0"
  }
}
